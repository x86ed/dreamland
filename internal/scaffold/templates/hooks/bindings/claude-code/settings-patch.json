{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {"type": "command", "command": "dreamland version-bump"},
          {"type": "command", "command": "dreamland coauthor --hook"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {"type": "command", "command": "dreamland coauthor --hook"}
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {"type": "command", "command": "dreamland guard-artifact"}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "dreamland version-bump --change-from-command"}
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {"type": "command", "command": "dreamland telemetry write --tool claude-code"},
          {"type": "command", "command": "dreamland version-bump --patch"},
          {"type": "command", "command": "dreamland version-bump --minor --if-agent janus"}
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {"type": "command", "command": "dreamland version-bump --patch"},
          {"type": "command", "command": "dreamland transition-log"},
          {"type": "command", "command": "dreamland telemetry write --tool claude-code"},
          {"type": "command", "command": "dreamland test-and-commit --reason turn-complete"}
        ]
      }
    ]
  }
}
