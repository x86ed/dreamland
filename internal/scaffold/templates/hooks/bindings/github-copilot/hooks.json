{
  "hooks": {
    "SessionStart": [
      {"type": "command", "command": "dreamland version-bump", "timeout": 30},
      {"type": "command", "command": "dreamland coauthor --hook", "timeout": 30},
      {"type": "command", "command": "dreamland otel-receiver", "timeout": 10}
    ],
    "SubagentStart": [
      {"type": "command", "command": "dreamland coauthor --hook", "timeout": 30}
    ],
    "SubagentStop": [
      {"type": "command", "command": "dreamland coauthor --hook", "timeout": 30},
      {"type": "command", "command": "dreamland telemetry write --tool github-copilot", "timeout": 30},
      {"type": "command", "command": "dreamland version-bump --patch", "timeout": 30},
      {"type": "command", "command": "dreamland commit --reason handoff", "timeout": 30}
    ],
    "Stop": [
      {"type": "command", "command": "dreamland version-bump --patch", "timeout": 30},
      {"type": "command", "command": "dreamland transition-log", "timeout": 30},
      {"type": "command", "command": "dreamland telemetry write --tool github-copilot", "timeout": 30},
      {"type": "command", "command": "dreamland test-and-commit --reason turn-complete", "timeout": 60}
    ]
  }
}
