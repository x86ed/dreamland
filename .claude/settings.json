{
  "permissions": {
    "allow": [
      "Bash(go version *)",
      "Bash(go get *)",
      "Bash(go build *)",
      "Bash(go mod *)",
      "Bash(openspec new *)",
      "Bash(openspec status *)",
      "Bash(openspec instructions *)",
      "Bash(bash scripts/pre-merge-check.sh*)",
      "Bash(MERGE_CHECK=1 bash scripts/pre-merge-check.sh)",
      "Bash(go test *)",
      "Bash(go tool *)",
      "Bash(go vet *)",
      "WebSearch",
      "WebFetch(domain:kiro.dev)",
      "WebFetch(domain:developers.openai.com)",
      "WebFetch(domain:cursor.com)",
      "WebFetch(domain:antigravity.google)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:code.visualstudio.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:codelabs.developers.google.com)",
      "WebFetch(domain:www.cursor.com)",
      "Bash(openspec list *)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:discuss.ai.google.dev)",
      "Bash(awk '{if \\($3 != \"100.0%\"\\) print}')",
      "Bash(awk '{if \\($3 ~ /[0-9]+\\\\.[0-9]+%/\\) {pct=substr\\($3, 1, length\\($3\\)-1\\); if \\(pct<100\\) print $1, $2, $3}}')",
      "Bash(openspec --version)",
      "Bash(openspec validate *)",
      "Bash(openspec --help)",
      "Bash(openspec change *)",
      "Bash(grep -n \"hooks:\\\\` field lists \\\\`coauthor\\\\`/\\\\`telemetry-write\\\\`\" /Users/adamsiegel/Workspace/git/dreamland/openspec/changes/janus-router-agent/proposal.md)",
      "Bash(/tmp/dreamland-bin init *)",
      "Bash(echo \"vet exit: $?\")",
      "Bash(go list *)",
      "Bash(gofmt -l .)",
      "Bash(gofmt -l *)",
      "Bash(git status *)",
      "Bash(git checkout *)",
      "Bash(gh --version)",
      "Bash(/tmp/dreamland-readme-check --help)",
      "Bash(/tmp/dreamland-readme-check init *)",
      "Bash(/tmp/dreamland-readme-check telemetry *)",
      "Bash(rm -f /tmp/dreamland-readme-check)",
      "Bash(gofmt -l internal/scaffold/*.go)",
      "Bash(go clean *)",
      "Bash(echo \"exit: $?\")",
      "Bash(python3 -c ' *)",
      "Bash(openspec spec *)",
      "Bash(openspec show *)",
      "Read(//tmp/**)",
      "Bash(git config *)",
      "Bash(cp dreamland *)",
      "Read(//Users/adamsiegel/.local/bin/**)",
      "Bash(dreamland coauthor *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dreamland version-bump --change-from-command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "dreamland coauthor"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "dreamland version-bump"
          },
          {
            "type": "command",
            "command": "dreamland coauthor"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/pre-merge-check.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "dreamland version-bump --patch"
          },
          {
            "type": "command",
            "command": "dreamland transition-log"
          },
          {
            "type": "command",
            "command": "dreamland test"
          },
          {
            "type": "command",
            "command": "dreamland telemetry write --tool claude-code"
          },
          {
            "type": "command",
            "command": "dreamland commit --reason turn-complete"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "dreamland coauthor"
          },
          {
            "type": "command",
            "command": "dreamland telemetry write --tool claude-code"
          },
          {
            "type": "command",
            "command": "dreamland version-bump --patch"
          },
          {
            "type": "command",
            "command": "dreamland version-bump --minor --if-agent janus"
          },
          {
            "type": "command",
            "command": "dreamland commit --reason handoff"
          }
        ]
      }
    ]
  }
}
